{
	"name": "@codeeditorland/nls",
	"version": "0.0.1",
	"private": false,
	"description": "NPM module to externalize and localize VSCode extensions",
	"keywords": [
		"codeeditorland",
		"land",
		"playform"
	],
	"homepage": "HTTPS://GitHub.Com/CodeEditorLand/LandNls#readme",
	"bugs": {
		"url": "HTTPS://GitHub.Com/CodeEditorLand/LandNls/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+HTTPS://github.com/CodeEditorLand/LandNls.git"
	},
	"license": "SEE LICENSE IN LICENSE",
	"author": {
		"name": "Source 🖋️ Open 👐🏻",
		"email": "Source/Open@Editor.Land",
		"url": "HTTPS://Editor.Land"
	},
	"type": "module",
	"main": "./lib/node/main.js",
	"browser": {
		"./lib/node/main.js": "./lib/browser/main.js"
	},
	"typings": "./lib/common/common.d.ts",
	"files": [
		"lib/common",
		"lib/browser",
		"lib/node",
		"!lib/*/test",
		"!lib/**/*.tsbuildinfo",
		"node.js",
		"node.d.ts",
		"browser.js",
		"browser.d.ts"
	],
	"scripts": {
		"clean": "rimraf lib",
		"compile": "tsc -b ./tsconfig.json",
		"prepublishOnly": "Build 'Source/**/*.ts'"
	},
	"dependencies": {},
	"devDependencies": {
		"@playform/build": "0.2.3",
		"@types/node": "22.14.1",
		"rimraf": "6.0.1"
	},
	"publishConfig": {
		"access": "public"
	}
}
